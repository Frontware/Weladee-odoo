<?xml version="1.0" encoding="utf-8"?>
<!-- 
	purpose : email template for sync
    
    2022-12-28 KPO updated to odoo 16.0
 -->
<odoo>
    <data noupdate="1">

        <record id="weladee_attendance_synchronous_cron_mail" model="mail.template">
            <field name="name">Weladee Attendance: Synchronization task</field>
            <field name="email_from"></field>
            <field name="email_to">{{ ctx.get('request-email','')}}</field>
            <field name="subject">Weladee Attendance Synchronization [{{ctx.get('request-status','')}}]: Result of the synchronization task from the request on {{ctx.get('request-date','')}}</field>
            <field name="model_id" ref="model_weladee_attendance_synchronous"/>
            <field name="body_html" type="html">
<div>
<p>Hi,
<br/>
A request has been made to perform Weladee Synchronization at <t t-esc="ctx.get('request-date')"/>
</p>
<t t-if="ctx.get('request-error',False)">
     An error occurred during synchronization:<br/>
    <ul>
    <t t-foreach="ctx.get('request-logs')" t-as="err">
      <t t-if="err[0] == 'e'">
        <li style="color:red" t-esc="err[1]"></li>
      </t>
    </t>
    </ul>
</t>    
<t t-if="not ctx.get('request-error',False)">

    <t t-if="ctx.get('request-logs-y',False) == 'Y'">

         An error occurred during synchronization:<br/>
        <ul>
            <t t-foreach="ctx.get('request-logs')" t-as="err">
                <t t-if="err[0] == 'e'">
                <li style="color:red" t-esc="err[1]"></li>
                </t>
            </t>
        </ul>
    </t>
    <t t-else="">

        The following data have been successfully synced with Weladee:<br/>
        <ul t-raw="ctx.get('features')">
        </ul>

    </t>

</t>
</div>
<p>
*This request and email were generated in the database <t t-esc="user.env.cr.dbname"/> within <t t-esc="ctx.get('request-elapse')"/>
</p>
</field>
        </record>

        <record id="weladee_attendance_synchronous_cron_mail_debug" model="mail.template">
            <field name="name">Weladee Attendance: Synchronization task (debug)</field>
            <field name="email_from"></field>
            <field name="email_to"></field>
            <field name="subject">Weladee Attendance Synchronization [{{ctx.get('request-status','')}}]: Result of the synchronization task from the request on {{ctx.get('request-date','')}}</field>
            <field name="model_id" ref="model_weladee_attendance_synchronous"/>
            <field name="body_html" type="html">
<div>
<p>Hi,
<br/>
A request has been made to perform Weladee Synchronization at <t t-esc="ctx.get('request-date')"/>
</p>
<t t-if="ctx.get('request-error',False)">
     An error occurred during synchronization:<br/>
    <ul>
    <t t-foreach="ctx.get('request-logs')" t-as="err">
      <t t-if="err[0] == 'e'">
        <li style="color:red" t-esc="err[1]"></li>
      </t>
    </t>
    </ul>
</t>
<t t-if="not ctx.get('request-error',False)">

    <t t-if="ctx.get('request-logs-y',False) == 'Y'">

         An error occurred during synchronization:<br/>
        <ul>
            <t t-foreach="ctx.get('request-logs')" t-as="err">
                <t t-if="err[0] == 'e'">
                <li style="color:red" t-esc="err[1]"></li>
                </t>
            </t>
        </ul>
    </t>
    <t t-else="">

        The following data have been successfully synced with Weladee:<br/>
        <ul t-raw="ctx.get('features')"></ul>

    </t>

</t>

<t t-if="ctx.get('request-debug','')">
    <br/>
    log info:<br/>
    <ul>
        <t t-foreach="ctx.get('request-logs')" t-as="err">
            <t t-if="err[0] == 'e'">
                <li style="color:red"><b><span t-esc="err[1]"/></b></li>
            </t>
            <t t-if="err[0] == 'w'">
                <li style="color:orange"><i><span t-esc="err[1]"/></i></li>
            </t>
            <t t-if="err[0] == 'd'">
                <li>---<span t-esc="err[1]"/></li>
            </t>
            <t t-if="err[0] == 'i'">
                <li><span t-esc="err[1]"/></li>
            </t>
        </t>
    </ul>
</t>
</div>
<p>
*This request and email were generated in the database <t t-esc="user.env.cr.dbname"/> within <t t-esc="ctx.get('request-elapse')"/>
</p>
</field>
        </record>
    </data>
</odoo>  