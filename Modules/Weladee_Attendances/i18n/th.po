#. module: Weladee_Attendances
#: model:mail.template,body_html:Weladee_Attendances.weladee_attendance_synchronous_cron_mail_debug
msgid ""
"<div>\n"
"<p>Hi,\n"
"<br>\n"
"A request has been made to perform Weladee Synchronization at <t t-esc=\"ctx.get('request-date')\"></t>\n"
"</p>\n"
"<t t-if=\"ctx.get('request-error',False)\">\n"
"     An error occurred during synchronization:<br>\n"
"    <ul>\n"
"    <t t-foreach=\"ctx.get('request-logs')\" t-as=\"err\">\n"
"      <t t-if=\"err[0] == 'e'\">\n"
"        <li style=\"color:red\" t-esc=\"err[1]\">\n"
"      </t>\n"
"    </t>\n"
"    </ul>\n"
"</t>\n"
"<t t-if=\"not ctx.get('request-error',False)\">\n"
"\n"
"    <t t-if=\"ctx.get('request-logs-y',False) == 'Y'\">\n"
"\n"
"         An error occurred during synchronization:<br>\n"
"        <ul>\n"
"            <t t-foreach=\"ctx.get('request-logs')\" t-as=\"err\">\n"
"                <t t-if=\"err[0] == 'e'\">\n"
"                <li style=\"color:red\" t-esc=\"err[1]\">\n"
"                </t>\n"
"            </t>\n"
"        </ul>\n"
"    </t>\n"
"    <t t-else=\"\">\n"
"\n"
"        The following data have been successfully synced with Weladee:<br>\n"
"        <ul t-raw=\"ctx.get('features')\"></ul>\n"
"\n"
"    </t>\n"
"\n"
"</t>\n"
"\n"
"<t t-if=\"ctx.get('request-debug','')\">\n"
"    <br>\n"
"    log info:<br>\n"
"    <ul>\n"
"        <t t-foreach=\"ctx.get('request-logs')\" t-as=\"err\">\n"
"            <t t-if=\"err[0] == 'e'\">\n"
"                <li style=\"color:red\"><b><span t-esc=\"err[1]\"></span></b></li>\n"
"            </t>\n"
"            <t t-if=\"err[0] == 'w'\">\n"
"                <li style=\"color:orange\"><i><span t-esc=\"err[1]\"></span></i></li>\n"
"            </t>\n"
"            <t t-if=\"err[0] == 'd'\">\n"
"                <li>---<span t-esc=\"err[1]\"></span></li>\n"
"            </t>\n"
"            <t t-if=\"err[0] == 'i'\">\n"
"                <li><span t-esc=\"err[1]\"></span></li>\n"
"            </t>\n"
"        </t>\n"
"    </ul>\n"
"</t>\n"
"</div>\n"
"<p>\n"
"*This request and email were generated in the database <t t-esc=\"user.env.cr.dbname\"></t> within <t t-esc=\"ctx.get('request-elapse')\"></t>\n"
"</p>\n"
msgstr ""
"<div>\n"
"<p>Hi,\n"
"<br>\n"
"มีการร้องขอให้ทำการซิงโครไนซ์เวลาดีเมื่อ <t t-esc=\"ctx.get('request-date')\"></t>\n"
"</p>\n"
"<t t-if=\"ctx.get('request-error',False)\">\n"
"     เกิดข้อผิดพลาดระหว่างการซิงโครไนซ์:<br>\n"
"    <ul>\n"
"    <t t-foreach=\"ctx.get('request-logs')\" t-as=\"err\">\n"
"      <t t-if=\"err[0] == 'e'\">\n"
"        <li style=\"color:red\" t-esc=\"err[1]\">\n"
"      </t>\n"
"    </t>\n"
"    </ul>\n"
"</t>\n"
"<t t-if=\"not ctx.get('request-error',False)\">\n"
"\n"
"    <t t-if=\"ctx.get('request-logs-y',False) == 'Y'\">\n"
"\n"
"         เกิดข้อผิดพลาดระหว่างการซิงโครไนซ์:<br>\n"
"        <ul>\n"
"            <t t-foreach=\"ctx.get('request-logs')\" t-as=\"err\">\n"
"                <t t-if=\"err[0] == 'e'\">\n"
"                <li style=\"color:red\" t-esc=\"err[1]\">\n"
"                </t>\n"
"            </t>\n"
"        </ul>\n"
"    </t>\n"
"    <t t-else=\"\">\n"
"\n"
"        ข้อมูลต่อไปนี้ได้ถูกซิงโครไนซ์กับเวลาดีสำเร็จแล้ว:<br>\n"
"        <ul t-raw=\"ctx.get('features')\"></ul>\n"
"\n"
"    </t>\n"
"\n"
"</t>\n"
"\n"
"<t t-if=\"ctx.get('request-debug','')\">\n"
"    <br>\n"
"    ข้อมูลเพิ่มเติม:<br>\n"
"    <ul>\n"
"        <t t-foreach=\"ctx.get('request-logs')\" t-as=\"err\">\n"
"            <t t-if=\"err[0] == 'e'\">\n"
"                <li style=\"color:red\"><b><span t-esc=\"err[1]\"></span></b></li>\n"
"            </t>\n"
"            <t t-if=\"err[0] == 'w'\">\n"
"                <li style=\"color:orange\"><i><span t-esc=\"err[1]\"></span></i></li>\n"
"            </t>\n"
"            <t t-if=\"err[0] == 'd'\">\n"
"                <li>---<span t-esc=\"err[1]\"></span></li>\n"
"            </t>\n"
"            <t t-if=\"err[0] == 'i'\">\n"
"                <li><span t-esc=\"err[1]\"></span></li>\n"
"            </t>\n"
"        </t>\n"
"    </ul>\n"
"</t>\n"
"</div>\n"
"<p>\n"
"*คำร้องขอและอีเมลถูกสร้างในฐานข้อมูล <t t-esc=\"user.env.cr.dbname\"></t> ใช้เวลา <t t-esc=\"ctx.get('request-elapse')\"></t>\n"
"</p>\n"

