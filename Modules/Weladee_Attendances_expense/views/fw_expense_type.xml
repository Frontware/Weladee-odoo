<?xml version="1.0"?>
<odoo>
    <record id="weladee_expense_type_tree" model="ir.ui.view">
        <field name="name">weladee_expense_type_tree</field>
        <field name="model">weladee_expense_type</field>
        <field name="arch" type="xml">
            <tree string="Type" edit="0" create="0" delete="0">
            <field name="code"/>
            <field name="name"/>
            </tree>                
        </field>
    </record>

    <record id="weladee_expense_type_view" model="ir.ui.view">
        <field name="name">weladee_expense_type_view</field>
        <field name="model">weladee_expense_type</field>
        <field name="arch" type="xml">
            <form string="Type" edit="0" create="0" delete="0">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <field name="weladee_id" invisible="1"/>
                        <button
                            name="open_weladee_type"
                            class="oe_stat_button"
                            type="object"
                            widget="url"
                            attrs="{'invisible':['|',('weladee_id','=',False),('weladee_id','=','')]}"
                        >
                            <div role="img" class="o_button_icon icon-weladee"/>
                            <div class="o_stat_info">
                                <span class="o_stat_text">Type</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                    <field name="active" invisible="1"/>
                    <field name="id" invisible="1"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label class="oe_edit_only" for="name" string="Name"/>
                        <h1><field name="name" placeholder="e.g. Gas"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                        </group>
                        <group>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="weladee_expense_type_action">
        <field name="name">Weladee Expense Type</field>
        <field name="res_model">weladee_expense_type</field>
        <field name="view_mode">tree,form</field>
    </record>  
    
    <menuitem id="weladee_expense_type_menu" name="Weladee Expense Type" 
        sequence="76" parent="hr_expense.menu_hr_expense_configuration" 
        action="weladee_expense_type_action" />

</odoo>

