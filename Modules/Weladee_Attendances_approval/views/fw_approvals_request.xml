<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="fw_approvals_view_fw_approvals_request_search2" model="ir.ui.view">
            <field name="name">fw_approvals_view_fw_approvals_request_search2</field>
            <field name="model">fw.approvals.request</field>
            <field name="inherit_id" ref="fw_approvals.view_fw_approvals_request_search"/>
            <field name="arch" type="xml">
                <xpath expr="/search" position="inside">
                    <field name="weladee_id"/>
                    <filter string="Weladee" name="filter_weladee" domain="[('is_weladee','=',True)]"/>
                    <group expand="0" string="Group By">
                        <filter string="Weladee" name="group_by_weladee" context="{'group_by':'is_weladee'}"/>
                    </group>
                </xpath>
            </field>
        </record>

        <record id="fw_approvals_weladee_request" model="ir.ui.view">
            <field name="name">fw_approvals_weladee_request</field>
            <field name="model">fw.approvals.request</field>
            <field name="inherit_id" ref="fw_approvals.fw_approvals_request_form"/>
            <field name="arch" type="xml">
               <xpath expr="//field[@name='name']//.." position="after">
                   <field name="weladee_id" invisible="1" />
                   <div attrs="{'invisible':['|',('weladee_id','=',''),('weladee_id','=',False)]}" style="color:red">
                   This record is imported from weladee, any change in odoo will be replaced by data from weladee.
                   </div>
                </xpath>

                <xpath expr="/form/sheet/*[position() = 1]" position="before">
                    <field name="weladee_id" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="open_weladee_approvals_request"
                            class="oe_stat_button"
                            type="object"
                            widget="url"
                            attrs="{'invisible':['|',('weladee_id','=',False),('weladee_id','=','')]}"
                        >
                            <div role="img" class="o_button_icon icon-weladee"/>
                            <div class="o_stat_info">
                                <span class="o_stat_text">Approval</span>
                                <span class="o_stat_value">Request</span>
                            </div>
                        </button>
                    </div>
                </xpath>

                <xpath expr="//notebook" position="inside">
                    <page string="Note" attrs="{'invisible':[('note','=',False)]}">
                        <field name="note"/>
                    </page>
                </xpath>

                <!-- Hide edit button if record comes from weladee -->
                <xpath expr="/form/sheet" position="inside">
                    <field name="hide_edit_btn_css"/>
                </xpath>
            </field>
        </record>
        <record id="fw_approvals_weladee_req_tree" model="ir.ui.view">
            <field name="name">fw_approvals_weladee_req_tree</field>
            <field name="model">fw.approvals.request</field>
            <field name="inherit_id" ref="fw_approvals.fw_approvals_request_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='state']" position="after">
                    <field name="weladee_id" invisible="1" />
                    <button attrs="{'invisible':['|',('weladee_id','=',False),('weladee_id','=','')]}" type="object" name="open_weladee_approvals_request" class="icon-weladee-kanban"></button>
                </xpath>
            </field>
        </record>

        <record id="fw_approvals_weladee_req_kanban" model="ir.ui.view">
            <field name="name">fw_approvals_weladee_req_kanban</field>
            <field name="model">fw.approvals.request</field>
            <field name="inherit_id" ref="fw_approvals.view_fw_approvals_request_kanban"/>
            <field name="priority">50</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='state']" position="after">
                    <field name="weladee_id"/>
                    <field name="weladee_url"/>
                </xpath>

                <xpath expr="//div[hasclass('oe_kanban_bottom_right')]" position="inside">
                    <a t-if="record.weladee_id.value" t-att="{'href':record.weladee_url.value}" target="_blank" style="width: 50px; text-align: right">
                        <span class="icon-weladee-kanban"></span>
                    </a>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
