<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="fw_worktype_view_form" model="ir.ui.view">
            <field name="name">fw_worktype_view_form</field>
            <field name="model">mail.activity.type</field>
            <field name="inherit_id" ref="mail.mail_activity_type_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('oe_title')]" position="before">
                    <div class="oe_button_box" name="button_box">
                    <field name="weladee_id" invisible="1"/>
                    <button
                            name="open_weladee_type"
                            class="oe_stat_button"
                            type="object"
                            widget="url"
                            attrs="{'invisible':['|',('weladee_id','=',False),('weladee_id','=','')]}"
                        >
                            <div role="img" class="o_button_icon icon-weladee"/>
                            <div class="o_stat_info">
                                <span class="o_stat_text">Weladee</span>
                                <span class="o_stat_value">WorkType</span>
                            </div>
                    </button>
                    </div>
                </xpath>
               <xpath expr="//field[@name='name']//..//.." position="after">
                   <div attrs="{'invisible':[('weladee_id','=',False)]}" style="color:red">
                   This record is imported from weladee, any change in odoo will be replaced by data from weladee.
                   </div>
               </xpath>

                <!-- Hide edit button if record comes from weladee -->
                <xpath expr="/form/sheet" position="inside">
                    <field name="hide_edit_btn_css"/>
                </xpath>
            </field>
        </record>

        <record id="fwweladee_tree_type" model="ir.ui.view">
            <field name="name">fwweladee_tree_type</field>
            <field name="model">mail.activity.type</field>
            <field name="inherit_id" ref="mail.mail_activity_type_view_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='icon']" position="after">
                    <field name="weladee_id" invisible="1" />
                    <button attrs="{'invisible':['|',('weladee_id','=',False),('weladee_id','=','')]}" type="object" name="open_weladee_type" class="icon-weladee-kanban"></button>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
