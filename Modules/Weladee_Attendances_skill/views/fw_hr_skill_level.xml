<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="fw_hr_skill_level_weladee_form" model="ir.ui.view">
            <field name="name">fw_hr_skill_level_weladee_form</field>
            <field name="model">hr.skill.level</field>
            <field name="inherit_id" ref="hr_skills.employee_skill_level_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']//.." position="after">
                   <field name="weladee_id" invisible="1" />
                   <div attrs="{'invisible':['|',('weladee_id','=',''),('weladee_id','=',False)]}" style="color:red">
                   This record is imported from weladee, any change in odoo will be replaced by data from weladee.
                   </div>
                </xpath>

                <!-- Hide edit button if record comes from weladee -->
                <xpath expr="/form/sheet" position="inside">
                    <field name="hide_edit_btn_css"/>
                </xpath>
            </field>
        </record>
        <record id="fw_hr_skill_level_weladee_tree" model="ir.ui.view">
            <field name="name">fw_hr_skill_level_weladee_tree</field>
            <field name="model">hr.skill.level</field>
            <field name="inherit_id" ref="hr_skills.employee_skill_level_view_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='default_level']" position="after">
                    <field name="weladee_id" invisible="1" />
                    <button attrs="{'invisible':['|',('weladee_id','=',False),('weladee_id','=','')]}" type="object" name="open_weladee_level" class="icon-weladee-kanban"></button>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
